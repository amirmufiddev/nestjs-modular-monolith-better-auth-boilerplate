# ===== APP =====
NODE_ENV=development
PORT=2001
APP_NAME=MyAppId
APP_VERSION=1.0.0
CORS_ORIGINS="http://localhost:2001,http://localhost:2000"
BASE_URL=http://localhost:2001

# ===== INTERNATIONALIZATION =====
FALLBACK_LANGUAGE=id

# ===== DATABASE (PostgreSQL via Drizzle) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=AflwObaOsWn+CXofYoLpmIHGL+GfMg85
POSTGRES_DB=myapp
DATABASE_URL="postgresql://postgres:AflwObaOsWn+CXofYoLpmIHGL+GfMg85@localhost:5432/myapp"

# ===== AUTH (Better Auth) =====
BETTER_AUTH_SECRET="898745516f61c8fc28173a66f31a7bae7f4b61d7cec98a963cf818e4de22c216"
BETTER_AUTH_URL=http://localhost:2001
BETTER_AUTH_PATH=/v1/auth
BETTER_AUTH_CLIENT_URL=http://localhost:2000
BETTER_AUTH_ERROR_PATH=/auth/error
BETTER_AUTH_INVITE_PATH=/auth/accept-invitation

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== EMAIL =====
EMAIL_ENABLED=true
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=cs@MyApp.id
EMAIL_FROM_NAME=No Reply
EMAIL_REPLY_TO=cs@MyApp.id
EMAIL_MAX_RECIPIENTS_PER_JOB=50
EMAIL_SUBJECT_PREFIX=[MyApp]
EMAIL_UI_PORT=8025

# Push (FCM) — kosongkan path untuk menonaktifkan
FCM_CREDENTIALS_PATH=keys/MyAppid-firebase-adminsdk-fbsvc-ecc4798d10.json

# ===== REDIS (cache adapter) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=7eLDGE85wJSPw7y3Cp2bgkr/oXS21W+b
REDIS_KEY_PREFIX=myapp
REDIS_URL=redis://default:7eLDGE85wJSPw7y3Cp2bgkr%2FoXS21W%2Bb@localhost:6379
BETTER_AUTH_REDIS_DB=1
BETTER_AUTH_REDIS_PREFIX=myapp-auth:

# ===== S3 / MinIO (upload) — jalankan: docker compose up -d minio =====
S3_ENDPOINT=http://127.0.0.1:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_REGION=ap-southeast-3
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY="mZunu4lLQrkH5J3Xji94Kr5wWnfwQRkS"
S3_BUCKET=uploads
S3_FORCE_PATH_STYLE=true

# ===== BULLMQ (broadcast push queue) =====
BROADCAST_QUEUE_ENABLED=true
BULLMQ_REDIS_DB=2
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_DELAY_MS=1000
BULLMQ_CONCURRENCY=5