NODE_ENV=development
PORT=2001
APP_NAME=MyApp
APP_VERSION=
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Better Auth
BETTER_AUTH_SECRET=your-secret-min-32-chars-here-change-in-production
BETTER_AUTH_URL=http://localhost:2001
BETTER_AUTH_PATH=/v1/auth
BETTER_AUTH_CLIENT_URL=http://localhost:5173
BETTER_AUTH_ERROR_PATH=/auth/error
BETTER_AUTH_INVITE_PATH=/accept-invite
CORS_ORIGINS=http://localhost:5173
FALLBACK_LANGUAGE=id
BASE_URL=http://localhost:2001

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
EMAIL_ENABLED=false
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=MyApp
EMAIL_REPLY_TO=noreply@example.com
EMAIL_TIMEOUT_MS=30000
EMAIL_MAX_RECIPIENTS_PER_JOB=50
EMAIL_SUBJECT_PREFIX=[MyApp]

# Redis (app cache + Better Auth secondary storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=app
BETTER_AUTH_REDIS_DB=1
BETTER_AUTH_REDIS_PREFIX=better-auth:

# BullMQ (optional — lihat docs/configuration-optional-integrations.md)
BROADCAST_QUEUE_ENABLED=false
BULLMQ_REDIS_DB=2
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_DELAY_MS=1000
BULLMQ_CONCURRENCY=5

# Object storage (S3-compatible — MinIO di docker-compose.yml)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=uploads
S3_FORCE_PATH_STYLE=true

# Integrasi opsional: FCM — lihat docs/configuration-optional-integrations.md
FCM_CREDENTIALS_PATH=