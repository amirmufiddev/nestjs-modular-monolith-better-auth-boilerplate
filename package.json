{
  "name": "nestjs-11-boilerplate",
  "version": "1.0.0",
  "description": "NestJS 11 modular monolith boilerplate — Fastify, Better Auth, Drizzle, Zod env, ESLint module boundaries.",
  "keywords": [
    "nestjs",
    "fastify",
    "better-auth",
    "drizzle",
    "modular-monolith",
    "boilerplate",
    "typescript"
  ],
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "depcheck": "depcheck",
    "test": "bun test",
    "test:cov": "bun test --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/database/seed.ts",
    "db:seed:regional": "bun run src/database/seeds/regional.seed.ts",
    "db:seed:org-members": "bun run src/database/seed-org-members.ts",
    "db:seed:org-invitations": "bun run src/database/seed-org-invitations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@better-auth/i18n": "^1.6.25",
    "@better-auth/redis-storage": "^1.7.1",
    "@fastify/compress": "^9.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@keyv/redis": "^5",
    "@nestjs/bullmq": "^11",
    "@nestjs/cache-manager": "^3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.1.28",
    "@scalar/nestjs-api-reference": "^1.2.11",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "@willsoto/nestjs-prometheus": "6.1.0",
    "argon2": "^0.45.1",
    "better-auth": "^1.6.0",
    "bullmq": "^5",
    "cache-manager": "^7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5",
    "keyv": "^5",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^9.0.3",
    "openai": "^7.4.0",
    "pg": "^8.13.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.0",
    "depcheck": "^1.4.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "mjs",
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true
          }
        }
      ],
      "^.+\\.mjs$": [
        "ts-jest",
        {
          "tsconfig": {
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^express$": "<rootDir>/__mocks__/express.mock.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/.*?/node_modules/)?(@thallesp/nestjs-better-auth|better-auth|@better-auth|rou3|better-call|@noble|jose|kysely)/)"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "setupFiles": [
      "<rootDir>/../test/setup.ts"
    ]
  }
}
